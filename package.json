{
  "name": "mars-ledger",
  "private": true,
  "description": "A table companion for the Terraforming Mars board game: phones for each player, a living planet on the TV.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "fetch-data": "node tools/fetch-data.mjs",
    "check-data": "node tools/check-data.mjs",
    "predev": "node tools/check-data.mjs",
    "dev": "concurrently -k \"tsx watch --env-file-if-exists=.env src/server/index.ts\" \"vite\"",
    "prebuild": "node tools/check-data.mjs",
    "build": "vite build && npm run build:server",
    "start": "node dist-server/index.js",
    "cards": "tsx tools/build-cards.ts",
    "pretest": "node tools/check-data.mjs",
    "test": "vitest run",
    "pretypecheck": "node tools/check-data.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist-server/index.js --banner:js=\"import {createRequire as __cr} from 'node:module'; const require = __cr(import.meta.url);\""
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.1",
    "@fontsource-variable/saira": "^5.3.0",
    "@react-three/fiber": "^9.8.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "fastify": "^5.12.5",
    "fuse.js": "^7.5.0",
    "motion": "^13.4.6",
    "nanoid": "^6.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
