# Mars Ledger settings. Every line is optional: with none of them set you get the full app on your LAN, with the
# number keypad and name search for cards, the 3D board, bots (Easy, Normal) and the end-of-game poster.
#
# Docker: copy this file to deploy/.env (next to docker-compose.yml) and edit it.
# Development: copy it to .env in the repository root; `npm run dev` reads it.
# Leave a value empty (or the line commented out) to keep its default.

# ---- Core ------------------------------------------------------------------------------------------------------
# The address phones open, shown as the QR code on the TV. Default: the address the TV page was opened with.
# Set it when the TV uses another name than the phones can reach, e.g. http://192.0.2.10:8080 or https://mars.example.com
#PUBLIC_URL=
# The port the published compose file exposes on the host (Docker only). Inside the container the app listens on 8080.
#MARS_LEDGER_PORT=8080
# The port the server listens on (development and custom setups).
#PORT=8080
# Where games, profiles, posters and narration audio are stored (SQLite and files). The image uses /data.
#DATA_DIR=./data
# The "Source code" link in the phone's game menu and on the TV lobby. If you run a changed version for other
# people, the AGPL asks you to offer them its source: point this at your own repository.
#SOURCE_URL=https://github.com/murtaza-nasir/mars-ledger

# ---- Images (Docker only) ----------------------------------------------------------------------------------------
# Published images to run; the defaults are the latest release. The build override
# (docker-compose.build.yml) ignores these and builds both images locally.
#MARS_LEDGER_IMAGE=ghcr.io/murtaza-nasir/mars-ledger:latest
#MARS_LEDGER_ENGINE_IMAGE=ghcr.io/murtaza-nasir/mars-ledger-engine:41a1b005de73

# ---- Engine (full-game mode) --------------------------------------------------------------------------------------
# The open-source Terraforming Mars server the app drives in full-game mode. The compose file sets it to the engine
# service. For development, run the engine on your machine (see the Development docs) and point at it.
#ENGINE_URL=http://localhost:8791
# false hides the full-game choice in the lobby (companion mode only, no engine needed).
#FULL_GAME=true
# How often the app asks the engine for changes, in milliseconds.
#ENGINE_POLL_MS=1200

# ---- Optional AI: photo scanning -----------------------------------------------------------------------------------
# A phone can photograph a card instead of typing its number. Needs a vision model. The photo button opens the
# phone's own camera, which most phones allow over plain HTTP (see the docs' HTTPS section).
# Providers are tried in order; a provider without its settings is skipped.
#VISION_ENABLED=true
#VISION_PROVIDERS=local,openrouter
# Any OpenAI-compatible server with a vision model (vLLM, llama.cpp server, Ollama, LM Studio). Both URL and model
# are needed. The URL ends in /v1.
#LOCAL_VLM_URL=http://<your-llm-server>:8000/v1
#LOCAL_VLM_MODEL=
#LOCAL_VLM_API_KEY=
# OpenRouter (paid, per request): https://openrouter.ai/keys
#OPENROUTER_API_KEY=
#OPENROUTER_VLM_MODEL=google/gemini-2.5-flash-lite

# ---- Optional AI: mission control (narrator) ----------------------------------------------------------------------
# Short lines about big moments on the TV, optionally spoken. The table turns it on in the lobby (default off).
# Needs an OpenAI-compatible chat model. Without NARRATOR_LLM_URL it uses LOCAL_VLM_URL and LOCAL_VLM_MODEL.
# Without any LLM the feature is hidden.
#NARRATOR_ENABLED=true
#NARRATOR_LLM_URL=http://<your-llm-server>:8000/v1
#NARRATOR_LLM_MODEL=
#NARRATOR_LLM_API_KEY=
#NARRATOR_LLM_TIMEOUT_MS=6000
# Voice ("Text + voice" is offered only with one of these):
#   an OpenAI-compatible /v1/audio/speech server (OpenAI itself, openedai-speech, Kokoro-FastAPI, ...)
#NARRATOR_TTS_URL=https://api.openai.com/v1
#NARRATOR_TTS_API_KEY=
#NARRATOR_TTS_MODEL=tts-1
#NARRATOR_VOICE=onyx
#NARRATOR_TTS_TIMEOUT_MS=8000
#   Paid voices, tried first in this order; the server above (if set) takes over for a line when they fail, are
#   slow or out of credits, or the game's budget is spent. Recommended: gemini.
#NARRATOR_TTS_PROVIDER=gemini
#   Gemini 3.8 Flash TTS through OpenRouter (paid, about $0.002 a line); uses OPENROUTER_API_KEY above.
#NARRATOR_GEMINI_VOICE=Charon
#NARRATOR_GEMINI_MODEL=google/gemini-3.8-flash-tts
#NARRATOR_GEMINI_TIMEOUT_MS=8000
#NARRATOR_GEMINI_USD_PER_MIN=0.0174
#   Hume Octave (paid, per character; NARRATOR_TTS_PROVIDER=hume). Hume ends its TTS API on 13 Nov 2026.
#HUME_API_KEY=
#NARRATOR_HUME_VOICE_ID=
#NARRATOR_HUME_VERSION=2
#NARRATOR_HUME_TIMEOUT_MS=6000
#NARRATOR_HUME_USD_PER_1K=0.0076
# Spend limit on paid speech per game, in US dollars.
#NARRATOR_TTS_BUDGET_USD=0.50
# A log file with one JSON line per narrated moment.
#NARRATOR_LOG=/data/narrator.jsonl

# ---- Optional: radio ----------------------------------------------------------------------------------------------
# A YouTube playlist the TV can play during a game (the id after list= in the playlist's URL). No radio without it.
#RADIO_PLAYLIST=

# ---- Optional: poster illustration -------------------------------------------------------------------------------
# The end-of-game poster always works with the built-in paintings. With a Stable Diffusion WebUI Forge (or
# AUTOMATIC1111) API here, the table can also ask for one new painting per game. It never changes that server's
# checkpoint and skips the painting when the server is busy.
#POSTER_FORGE_URL=http://<your-forge-server>:7860
#POSTER_FORGE_TIMEOUT_MS=60000
#POSTER_UNIQUE_ENABLED=true

# ---- Bots -----------------------------------------------------------------------------------------------------
# Easy and Normal bots always work. The Hard (Jev) level asks TypeSafe's Jev decision model and appears in the lobby
# only with a key (paid, per decision).
#TYPESAFE_API_KEY=
# Spend limit on Jev per game, in US dollars; after it, Jev seats play as Normal.
#BOT_JEV_BUDGET_USD=0.10
# Scales the bots' human-like pauses (0 makes them instant, 2 twice as slow).
#BOT_DELAY_SCALE=1
# Append every bot decision to this file as JSON lines (for tuning).
#BOT_LOG=

# ---- Tuning ------------------------------------------------------------------------------------------------------
# How long a phone must be away before it gets a "While you were away" summary, in milliseconds.
#AWAY_MIN_MS=60000
# How often the server checks that each screen is in step, in milliseconds.
#SYNC_HEARTBEAT_MS=2000
# Extra engine game options as JSON (testing), e.g. {"includedCards": ["Birds"]}.
#ENGINE_GAME_OPTIONS=
# Paths, found automatically; change them only for a custom layout. CLIENT_DIST is the built web client
# (the image sets /app/dist), POSTER_ASSETS the poster fonts and paintings, RESVG_WASM the poster renderer.
#CLIENT_DIST=dist
#POSTER_ASSETS=
#RESVG_WASM=

# ---- Experimental -------------------------------------------------------------------------------------------------
# Let a decision model pick among Normal's options for every Normal bot (research tooling). See docs: Bots.
#BOT_JUDGE=
#BOT_JUDGE_SPEC=
#BOT_JUDGE_BOTS=
#BOT_JUDGE_URL=
#BOT_JUDGE_MODEL=
#BOT_JUDGE_TIMEOUT_MS=10000
#BOT_JUDGE_CONTEXT=c1
#BOT_JUDGE_CANDIDATES=top6
#BOT_JUDGE_SKIP=
